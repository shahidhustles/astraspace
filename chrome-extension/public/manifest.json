{
  "manifest_version": 3,
  "name": "Astra Space",
  "version": "0.0.0",
  "description": "A privacy-first browser agent.",
  "key": "",
  "minimum_chrome_version": "118",
  "host_permissions": [
    "http://127.0.0.1:2000/*",
    "<all_urls>"
  ],
  "permissions": [
    "sidePanel",
    "tabs",
    "debugger",
    "activeTab",
    "scripting",
    "tabGroups",
    "windows",
    "storage",
    "alarms"
  ],
  "action": {
    "default_title": "Open Astra Space"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "browser-control/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "browser-control/icons/icon16.png",
    "48": "browser-control/icons/icon48.png",
    "128": "browser-control/icons/icon128.png"
  }
}