{
  "manifest_version": 3,
  "name": "Astra Space",
  "version": "0.0.0",
  "description": "A privacy-first browser agent.",
  "key": "",
  "minimum_chrome_version": "118",
  "host_permissions": ["http://127.0.0.1:2000/*"],
  "permissions": ["sidePanel", "debugger", "tabs", "storage"],
  "action": {
    "default_title": "Open Astra Space"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
