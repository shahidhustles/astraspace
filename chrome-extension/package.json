{
  "name": "@astra-space/chrome-extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:integration": "bun run build:extension && ASTRA_FIXTURE_MODELS=1 bun test --timeout 30000 --max-concurrency 1 tests/browser-observation.integration.test.ts tests/browser-action-catalog.integration.test.ts tests/browser-mv3-runtime.integration.test.ts tests/browser-action-waits.integration.test.ts tests/browser-eve-observe.integration.test.ts tests/browser-eve-actions.integration.test.ts tests/eve-browser-control-loop.integration.test.ts",
    "test:scan": "bun test tests/built-bundle-import-scan.test.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "happy-dom": "^20.11.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@astra-space/browser-control-contract": "workspace:*",
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-slot": "^1.3.3",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "ai": "^7.0.79",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eve": "^0.44.4",
    "feral-blob": "^0.1.0",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "puppeteer-core": "^25.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "use-stick-to-bottom": "^1.1.6"
  }
}
